# Configuracao local do ReVeste Backend.
# Copie este arquivo para .env e substitua os valores necessarios.
MODE=DEVELOPMENT
DEBUG=True
SECRET_KEY=troque-por-uma-chave-local
# Sem DATABASE_URL, o Django usa SQLite (db.sqlite3) para testes locais.
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# Necessario para processar pagamentos. Use SOMENTE o Access Token de TESTE.
MERCADO_PAGO_ACCESS_TOKEN=
# Opcional para validar notificacoes reais. Configure o segredo de webhook no painel.
MERCADO_PAGO_WEBHOOK_SECRET=
# Deixe vazio para testes locais sem tunel publico; localhost nao recebe webhooks externos.
MERCADO_PAGO_WEBHOOK_URL=

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Variaveis abaixo so sao necessarias se os recursos correspondentes forem usados.
CLOUDINARY_URL=
PASSAGE_APP_ID=
PASSAGE_API_KEY=
MY_IP=127.0.0.1
